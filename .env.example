PORT=3000
APP_ORIGIN=http://localhost:3000
NODE_ENV=development
CONTACT_EMAIL=renewradar@gmail.com

# Turso cloud database. Leave both blank only for local SQLite development.
TURSO_DATABASE_URL=libsql://your-database-your-organization.turso.io
TURSO_AUTH_TOKEN=your_turso_auth_token

# Email delivery through Resend.
RESEND_API_KEY=re_your_resend_api_key
# Before you own a domain, use Resend's test sender as shown in its dashboard.
MAIL_FROM=RenewalRadar <onboarding@resend.dev>

# Stripe test mode only. These values are Stripe Price IDs, not amounts.
STRIPE_SECRET_KEY=sk_test_...
STRIPE_WEBHOOK_SECRET=whsec_...
STRIPE_PRICE_MONTHLY=price_...
STRIPE_PRICE_YEARLY=price_...
STRIPE_AUTOMATIC_TAX=false

ANALYTICS_ENABLED=false

# Protects the scheduled Vercel reminder endpoint. Generate a random 32+ char value.
CRON_SECRET=replace_with_a_random_secret
