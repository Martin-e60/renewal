PORT=3000
# Optional on localhost and GitHub Codespaces (automatically detected).
# Set this to your exact public https:// domain when deploying elsewhere.
# APP_ORIGIN=https://your-domain.example
NODE_ENV=development
CONTACT_EMAIL=hello@renewalradar.example
# Optional: additional exact origins, comma-separated. No wildcard hosts.
# ALLOWED_ORIGINS=
# Keep DATA_DIR on a persistent disk; default ./data next to the app.
# DATA_DIR=/absolute/persistent/path
# Your HTTPS mail relay must implement the contract in README.md.
# MAIL_WEBHOOK_URL=https://your-mail-relay.example/send
# MAIL_WEBHOOK_TOKEN=

# Real email delivery (alternative to your mail relay). Verify MAIL_FROM's domain.
# RESEND_API_KEY=
# MAIL_FROM=RenewalRadar <notifications@your-domain.example>

# Use test credentials first, then all corresponding live-mode values.
# STRIPE_SECRET_KEY=
# STRIPE_WEBHOOK_SECRET=
# STRIPE_PRICE_MONTHLY=price_...
# STRIPE_PRICE_YEARLY=price_...
# Optional existing Stripe customer portal configuration:
# STRIPE_PORTAL_CONFIGURATION=bpc_...
# Only enable after setting up Stripe Tax for your business:
STRIPE_AUTOMATIC_TAX=false
